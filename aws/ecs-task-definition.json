{
  "family": "ai-healthguard-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ai-healthguard-task-role",
  "containerDefinitions": [
    {
      "name": "ai-healthguard",
      "image": "<AWS_ECR_REPOSITORY_URI>:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "GEMINI_API_KEY", "value": "${GEMINI_API_KEY}" },
        { "name": "JWT_SECRET", "value": "${JWT_SECRET}" },
        { "name": "MONGO_URI", "value": "${MONGO_URI}" },
        { "name": "MONGO_DB", "value": "${MONGO_DB}" },
        { "name": "APP_URL", "value": "${APP_URL}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-healthguard",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ai-healthguard"
        }
      }
    }
  ]
}
